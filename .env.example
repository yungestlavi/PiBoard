# --- Percorsi / rete ---
DATA_DIR=/data
HOST=0.0.0.0
PORT=8080

# --- Sicurezza / immagini ---
ADMIN_PASSWORD=
MAX_IMAGE_DIM=2560

# --- OneDrive / Microsoft Graph (device code flow) ---
# Registra su https://entra.microsoft.com una app "public client"
# (Authentication > Allow public client flows = Yes) con permesso Files.Read.
MS_CLIENT_ID=
MS_TENANT=common
MS_SCOPES=Files.Read offline_access
ONEDRIVE_FOLDER=/Photos

# --- Google Photos (Picker API) ---
# Crea credenziali OAuth "Web application" su https://console.cloud.google.com
# abilitando la Photos Picker API. NON mettere qui valori veri: solo nel .env!
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/accounts/google/callback

# --- Google Drive (sincronizzazione di una cartella) ---
# Stesso progetto Google Cloud: credenziali OAuth "Web application" con
# redirect http://localhost:8080/api/gdrive/callback e Drive API abilitata.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_FOLDER_NAME=PiBoard
# Metodo consigliato: cartella condivisa "con chiunque abbia il link".
# Basta una API key (Drive API abilitata). Puoi anche impostarla dal pannello.
GDRIVE_API_KEY=

# --- Sorgente locale / NAS (opzionale) ---
# Cartella montata via fstab (Samba/NFS). Lascia vuoto per disabilitare.
LOCAL_PHOTOS_PATH=

# --- Cache / rotazione ---
PHOTO_SYNC_MINUTES=30
ROTATE_SECONDS=60
MAX_CACHE_ITEMS=300
